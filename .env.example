DATABASE_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NODE_ENV=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

NEXT_PUBLIC_WEB_SOCKET_URL=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=http://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=call-recordings

# LocalStack (profile avatar storage, via docker-compose.localstack.yml)
# The image requires a license token to start; get one at https://app.localstack.cloud
# The S3_* / AWS_* vars below are read by docker-compose; the app reads its own
# copy from apps/web/.env.local (see apps/web/.env.example).
# For production avatars, use Cloudflare R2: endpoint https://<account_id>.r2.cloudflarestorage.com,
# AWS_REGION=auto, keep S3_FORCE_PATH_STYLE=true, and set S3_PUBLIC_BASE_URL to your R2 custom domain.
LOCALSTACK_AUTH_TOKEN=
S3_BUCKET=avatars
AWS_REGION=us-east-1

ALLOWED_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000

# Service-to-service link from the Next.js app to the WebSocket service
# (apps/web-socket). Used by the git workspace client and by the notification
# push that delivers a notification to a recipient's open socket immediately.
# The secret must match GIT_SERVICE_SECRET in apps/web-socket/.env.
# Unset, both features degrade quietly: notifications still persist and appear
# on the next page load, they just aren't pushed live.
GIT_SERVICE_URL=http://localhost:8080
GIT_SERVICE_SECRET=

# LLM-powered assistant for group queries ("What did I miss?")
# Powered by Groq's mixtral-8x7b-32768 model (free tier, 32K context).
# Get your API key at https://console.groq.com/keys
# Unused: assistant features disabled.
GROQ_API_KEY=

