{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ALLOWED_ORIGINS",
        "AWS_ACCESS_KEY_ID",
        "AWS_REGION",
        "AWS_SECRET_ACCESS_KEY",
        "BUG_ADMIN_EMAIL",
        "BUG_REPORT_GITHUB_TOKEN",
        "BUG_REPORT_REPO",
        "DATABASE_URL",
        "DRAFT_BUCKET",
        "EMAIL_FROM",
        "EMAIL_PASS",
        "EMAIL_PASSWORD",
        "EMAIL_SERVER_HOST",
        "EMAIL_SERVER_PASSWORD",
        "EMAIL_SERVER_PORT",
        "EMAIL_SERVER_USER",
        "EMAIL_USER",
        "ENCRYPTION_KEY",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GIT_SERVICE_SECRET",
        "GIT_SERVICE_URL",
        "GROQ_API_KEY",
        "GROQ_MODEL",
        "JWT_SECRET",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "LIVEKIT_HOST",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_LIVEKIT_URL",
        "NEXT_PUBLIC_WEB_SOCKET_URL",
        "NEXT_PUBLIC_WS_URL",
        "NODE_ENV",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_PUBLIC_BASE_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL",
        "WEB_SOCKET_URL",
        "WS_ALLOWED_ORIGINS",
        "WS_AUTH_SECRET"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    }
  }
}
