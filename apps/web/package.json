{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:generate": "prisma generate ",
    "test": "vitest run",
    "test:storage": "vitest run --config vitest.storage.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:seed": "npx tsx prisma/seed-call.ts",
    "localstack:up": "docker-compose -f ../../docker-compose.localstack.yml up -d",
    "localstack:down": "docker-compose -f ../../docker-compose.localstack.yml down",
    "localstack:logs": "docker-compose -f ../../docker-compose.localstack.yml logs -f localstack"
  },
