generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === USER MODEL ===
model User {
  id            String    @id @default(cuid())
  email         String    @unique // Changed from optional to required
  name          String?
  image         String?
  emailVerified DateTime?

  // Custom fields
  phone               String?         @unique
  password            String?
  chats               Chat[]          @relation("ChatParticipants")
  sentMessages        Messages[]      @relation("SenderMessages")
  receivedMessages    Messages[]      @relation("RecipientMessages")
  sentFriendships     Friendship[]    @relation("FriendshipSender")
  receivedFriendships Friendship[]    @relation("FriendshipReceiver")
  ownedGroups         Group[]         @relation("OwnerGroups")
  groupMembers        GroupMember[]   @relation("UserGroups")
  groupMessages       GroupMessage[]  @relation("GroupMessages")
  userModifiedFiles   ModifiedFiles[] @relation("userModifiedFile")

  // Call relations
  initiatedCalls      CallRoom[]         @relation("CallInitiator")
  callParticipants    CallParticipant[]
  initiatedRecordings CallRecording[]    @relation("RecordingInitiator")
  pushSubscriptions   PushSubscription[]

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  authoredChangeRequests ChangeRequest[]    @relation("AuthoredChangeRequests")
  bugReports             BugReport[]        @relation("UserBugReports")
  planningAssignments    PlanningAssignee[] @relation("UserPlanningAssignments")
  assistantConversations AssistantConversation[] @relation("UserAssistantConversations")

  // Add timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One Ko-Lab Assistant chat. Each user message spends one credit; when the
// allowance is used up the user starts a new conversation. creditsTotal is
// stored per row so changing the default doesn't alter conversations already
// in progress.
model AssistantConversation {
  id           String   @id @default(cuid())
  userId       String
  creditsTotal Int
  creditsUsed  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("UserAssistantConversations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === NEXTAUTH MODELS ===
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// === CUSTOM MODELS ===
model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id])
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id])
}

model Chat {
  id           String     @id @default(cuid())
  participants User[]     @relation("ChatParticipants")
  messages     Messages[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Messages {
  id          String   @id @default(cuid())
  content     String
  senderId    String
  chatId      String
  recipientId String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chat      Chat @relation(fields: [chatId], references: [id])
  sender    User @relation("SenderMessages", fields: [senderId], references: [id])
  recipient User @relation("RecipientMessages", fields: [recipientId], references: [id])

  @@index([chatId])
  @@index([recipientId, isRead])
}

model Otp {
  id        String   @id @default(cuid())
  otp       String
  email     String
  phone     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model Group {
  id                String   @id @default(cuid())
  groupName         String
  githubRepo        String
  ownerName         String
  githubAccessToken String
  sshKey            String?
  ownerId           String
  liveUrl           String?
  createdAt         DateTime @default(now())

  // Cached repo metadata (refreshed on load / sync) — avoids assuming "main"
  defaultBranch String?
  headSha       String?

  // Shown in the workspace details panel. Both optional — a group created
  // before this existed simply renders without them.
  description String?
  coverImage  String?

  owner           User?            @relation("OwnerGroups", fields: [ownerId], references: [id])
  members         GroupMember[]    @relation("GroupToMembers")
  groupMessage    GroupMessage[]   @relation("GroupMessage")
  modifiedFiles   ModifiedFiles[]  @relation("modifiedFiles")
  workspaceBoards WorkspaceBoard[] @relation("GroupWorkspaceBoards")
  changeRequests  ChangeRequest[]  @relation("GroupChangeRequests")

  planningColumns    PlanningColumn[]    @relation("GroupPlanningColumns")
  planningTasks      PlanningTask[]      @relation("GroupPlanningTasks")
  planningMilestones PlanningMilestone[] @relation("GroupPlanningMilestones")
  inviteLinks        GroupInviteLink[]   @relation("GroupInviteLinks")
}

enum ChangeRequestStatus {
  OPEN
  MERGED
  REJECTED
  CONFLICT
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  WONT_FIX
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BugCategory {
  BUG
  UI
  PERFORMANCE
  OTHER
}

model BugReport {
  id             String      @id @default(cuid())
  reporterId     String
  title          String
  description    String      @db.Text
  category       BugCategory @default(BUG)
  severity       BugSeverity @default(MEDIUM)
  status         BugStatus   @default(OPEN)
  // Auto-captured context
  url            String?
  userAgent      String?
  context        Json?
  screenshot     String?     @db.Text // data URL (v1)
  // GitHub linkage
  githubIssueNo  Int?
  githubIssueUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  reporter User @relation("UserBugReports", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([status])
}

model ChangeRequest {
  id         String              @id @default(cuid())
  groupId    String
  authorId   String
  title      String
  branchName String
  prNumber   Int?
  prUrl      String?
  status     ChangeRequestStatus @default(OPEN)
  baseSha    String?
  // Snapshot of the files this CR carried (path + content), for the review UI
  files      Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  group  Group @relation("GroupChangeRequests", fields: [groupId], references: [id])
  author User  @relation("AuthoredChangeRequests", fields: [authorId], references: [id])

  @@index([groupId])
  @@index([authorId])
}

enum WorkspaceBoardType {
  MIND_MAP
  PLANNING
  DB_SCHEMA
  UI_DESIGN
}

model WorkspaceBoard {
  id        String             @id @default(cuid())
  groupId   String
  type      WorkspaceBoardType
  content   Json
  updatedAt DateTime           @updatedAt
  createdAt DateTime           @default(now())

  group Group @relation("GroupWorkspaceBoards", fields: [groupId], references: [id])

  @@unique([groupId, type])
  @@index([groupId])
}

// === PLANNING & MILESTONES ===
// The planning board outgrew WorkspaceBoard.content (a JSON blob): cards need
// assignees, dates and per-column counts, none of which are queryable inside
// JSON — and the whole blob had to cross the 8KB WebSocket frame limit on every
// edit. The other three board types still use WorkspaceBoard.

model PlanningColumn {
  id        String   @id @default(cuid())
  groupId   String
  title     String
  // Gapped integers, so reordering one column doesn't rewrite its siblings.
  position  Int
  color     String?
  createdAt DateTime @default(now())

  group Group          @relation("GroupPlanningColumns", fields: [groupId], references: [id])
  tasks PlanningTask[]

  @@index([groupId, position])
}

enum PlanningPriority {
  LOW
  MEDIUM
  HIGH
}

model PlanningTask {
  id          String            @id @default(cuid())
  // Denormalized from the column so the whole board loads in one query.
  groupId     String
  columnId    String
  title       String
  description String?
  position    Int
  // Optional: a task without a stated priority is neither urgent nor trivial,
  // which is different from explicitly choosing MEDIUM.
  priority    PlanningPriority?
  // Timeline bar span. Null means the task isn't scheduled and draws no bar.
  startDate   DateTime?
  dueDate     DateTime?
  color       String?
  milestoneId String?
  // Workflow canvas coordinates. Distinct from `position`, which is the sort
  // key within a column. Null until the task is first dragged on the canvas.
  flowX       Float?
  flowY       Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  group     Group                    @relation("GroupPlanningTasks", fields: [groupId], references: [id])
  column    PlanningColumn           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  milestone PlanningMilestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees PlanningAssignee[]
  /// Edges where this task is the blocker (it points at others).
  blocks    PlanningTaskDependency[] @relation("TaskBlocks")
  /// Edges where this task is waiting on others.
  blockedBy PlanningTaskDependency[] @relation("TaskBlockedBy")

  @@index([groupId])
  @@index([columnId, position])
  @@index([milestoneId])
}

/// "blocker must finish before dependent starts" — the arrows in the workflow
/// view. A join table rather than a column because a task can have several
/// blockers and block several others.
model PlanningTaskDependency {
  id          String   @id @default(cuid())
  groupId     String
  /// The task that must finish first.
  blockerId   String
  /// The task waiting on it.
  dependentId String
  createdAt   DateTime @default(now())

  blocker   PlanningTask @relation("TaskBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  dependent PlanningTask @relation("TaskBlockedBy", fields: [dependentId], references: [id], onDelete: Cascade)

  // One edge per pair, in one direction.
  @@unique([blockerId, dependentId])
  @@index([groupId])
  @@index([dependentId])
}

model PlanningAssignee {
  taskId String
  userId String

  task PlanningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User         @relation("UserPlanningAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model PlanningMilestone {
  id        String    @id @default(cuid())
  groupId   String
  title     String
  startDate DateTime?
  dueDate   DateTime
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  group Group          @relation("GroupPlanningMilestones", fields: [groupId], references: [id])
  tasks PlanningTask[]

  @@index([groupId])
}

model GroupMember {
  id      String    @id @default(cuid())
  groupId String
  userId  String
  group   Group     @relation("GroupToMembers", fields: [groupId], references: [id])
  user    User      @relation("UserGroups", fields: [userId], references: [id])
  role    GroupRole @default(MEMBER)

  // Code-access lifecycle, separate from group membership.
  // NONE           → not yet a repo collaborator
  // PENDING_GITHUB → owner wants to invite, but member hasn't linked GitHub yet
  // INVITED        → GitHub collaborator invitation sent, awaiting acceptance
  // ACTIVE         → accepted; can push / open change-requests
  codeAccess CodeAccessStatus @default(NONE)

  @@index([groupId])
  @@index([userId])
}

enum CodeAccessStatus {
  NONE
  PENDING_GITHUB
  INVITED
  ACTIVE
}

model Invite {
  id String @id @default(cuid())
  // Exactly one of phone/email identifies the invitee, depending on which the
  // inviter typed. Both are optional so either kind of invite can be stored.
  phone     String?
  email     String?
  groupId   String
  status    String   @default("pending")
  createdAt DateTime

  @@unique([phone, groupId])
  @@unique([email, groupId])
}

/// A shareable join key for a group.
///
/// Separate from Invite, which is phone-keyed and part of a unique constraint —
/// a link has no phone number, so widening that model would mean making a
/// constrained column nullable. This grants **group membership only**; repo
/// push access stays an explicit per-member owner action, so forwarding a link
/// can never hand someone access to the GitHub repo.
model GroupInviteLink {
  id        String    @id @default(cuid())
  token     String    @unique
  groupId   String
  createdBy String
  expiresAt DateTime?
  revokedAt DateTime?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())

  group Group @relation("GroupInviteLinks", fields: [groupId], references: [id])

  @@index([groupId])
}

model GroupMessage {
  id         String   @id @default(cuid())
  groupId    String
  senderId   String
  senderName String?
  message    String
  createdAt  DateTime @default(now())

  user  User  @relation("GroupMessages", fields: [senderId], references: [id])
  group Group @relation("GroupMessage", fields: [groupId], references: [id])
}

model File {
  id        Int        @id @default(autoincrement())
  name      String
  userId    String
  path      String
  content   String
  ownerId   String     @default("")
  ownerName String     @default("")
  updatedAt DateTime   @updatedAt
  group     String
  status    FileStatus @default(PENDING)

  // optional relation if needed
  // user User @relation(fields: [userId], references: [id])
}

model ModifiedFiles {
  id           Int     @id @default(autoincrement())
  name         String
  path         String
  // Draft content lives in the user's private draft clone on the git service
  // (per-group, per-user), not here. This column is kept nullable only as a
  // legacy fallback for rows saved before Phase 2; new saves write null.
  content      String? @db.Text
  userId       String
  groupId      String
  modifiedById String?
  // Commit sha of the default branch when this draft session started —
  // the CR branch is cut from here so the author's work sits on what they saw.
  baseSha      String?
  // A staged deletion. The row exists so the intent travels through the normal
  // change-request review, and the file is only removed when the CR is merged.
  deleted      Boolean @default(false)

  changes    Change[] @relation("changedFile")
  modifiedBy User?    @relation("userModifiedFile", fields: [modifiedById], references: [id])
  group      Group    @relation("modifiedFiles", fields: [groupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId, path], name: "userId_groupId_path")
}

model Change {
  id         Int           @id @default(autoincrement())
  fileId     Int
  file       ModifiedFiles @relation("changedFile", fields: [fileId], references: [id])
  type       String
  lineNumber Int
  content    String
  createdAt  DateTime      @default(now())
}

model Notifications {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  userName  String
  ownerId   String
  ownerName String
  groupName String
  message   String?
  createdAt DateTime @default(now())

  // Who should see this. `ownerId` was the de-facto recipient, which meant a
  // notification could only ever be addressed to a group owner — there was no
  // way to tell a member anything. Nullable so existing rows keep working:
  // readers fall back to ownerId when this is null.
  recipientId String?
  // Distinguishes an access grant from a change request, so the UI can render
  // the right copy and action.
  type        String?
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@index([ownerId])
}

model RejectedCr {
  id        String   @id @default(cuid())
  message   String
  groupId   String
  groupName String
  userId    String
  userName  String
  createdAt DateTime @default(now())
}

model ApprovedCr {
  id        String   @id @default(cuid())
  message   String
  userId    String
  groupId   String
  groupName String
  userName  String
  createdAt DateTime @default(now())
}

model GuestUser {
  id          String       @id @default(cuid())
  guestId     String
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  guestGroups GuestGroup[] @relation("UserToGuestGroups")
}

model GuestGroup {
  id      String @id @default(cuid())
  groupId String
  ownerId String
  userId  String

  user GuestUser @relation("UserToGuestGroups", fields: [userId], references: [id])

  @@index([userId])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  description String
  userId      String?  @unique
  createdAt   DateTime @default(now())
}

// === CALL MODELS ===

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  REJECTED
}

enum CallType {
  AUDIO
  VIDEO
  GROUP
}

model CallRoom {
  id          String     @id @default(cuid())
  livekitRoom String     @unique
  type        CallType
  status      CallStatus @default(RINGING)
  groupId     String?
  initiatorId String
  startedAt   DateTime   @default(now())
  endedAt     DateTime?

  participants CallParticipant[]
  recordings   CallRecording[]
  initiator    User              @relation("CallInitiator", fields: [initiatorId], references: [id])

  @@index([status])
  @@index([groupId])
  @@index([livekitRoom])
}

model CallParticipant {
  id              String    @id @default(cuid())
  callId          String
  userId          String
  joinedAt        DateTime?
  leftAt          DateTime?
  isScreenSharing Boolean   @default(false)
  isMuted         Boolean   @default(false)
  isVideoOff      Boolean   @default(false)

  call CallRoom @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
}

enum RecordingStatus {
  RECORDING
  COMPLETED
  FAILED
}

model CallRecording {
  id            String          @id @default(cuid())
  callId        String
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  filePath      String?
  fileSize      Int?
  durationMs    Int?
  resolution    String          @default("1080p")
  status        RecordingStatus @default(RECORDING)
  initiatedById String

  call        CallRoom @relation(fields: [callId], references: [id], onDelete: Cascade)
  initiatedBy User     @relation("RecordingInitiator", fields: [initiatedById], references: [id])

  @@index([callId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

// === ENUMS ===
enum FileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupRole {
  ADMIN
  MEMBER
}
