# Shared secret for verifying WebSocket auth tokens minted by apps/web.
# Must match WS_AUTH_SECRET (or NEXTAUTH_SECRET) in apps/web's env.
WS_AUTH_SECRET=

# Comma-separated list of allowed origins (defaults to http://localhost:3000)
WS_ALLOWED_ORIGINS=

# HTTPS service-to-service secret shared with apps/web (GIT_SERVICE_SECRET there).
# The git workspace router (clone/read files) requires this on every request.
GIT_SERVICE_SECRET=

# Where cloned repos are stored. Use a Render persistent disk in production.
GIT_WORKSPACE_ROOT=/data/workspaces
