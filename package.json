{
  "name": "ko-lab",
  "private": true,
  "scripts": {
    "start": "turbo start",
    "build": "npm run db:web && turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start-user-app": "cd ./apps/web && npm run dev",
    "db:web": "cd apps/web && npx prisma generate && cd ../.."
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.2.5",
    "turbo": "^2.1.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^5.19.1",
    "crypto": "^1.0.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.11.15",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.456.0",
    "next-auth": "^4.24.7",
    "octokit": "^4.0.2",
    "prisma": "^5.19.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "shepherd.js": "^15.0.0",
    "uuid": "^10.0.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
